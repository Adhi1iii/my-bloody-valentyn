<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Valentine?</title>

<style>
body {
  margin: 0;
  overflow: hidden;
  background: linear-gradient(135deg, #ffb6c1, #ffc0cb);
  font-family: Comic Sans MS, cursive;
  text-align: center;
}

/* Floating sobbing emojis */
.emoji {
  position: fixed;
  font-size: 24px;
  animation: float 10s linear infinite;
  opacity: 0.6;
}

@keyframes float {
  from { transform: translateY(100vh); }
  to { transform: translateY(-10vh); }
}

/* Main content */
.container {
  position: relative;
  z-index: 10;
  top: 20vh;
}

h1 {
  font-size: clamp(28px, 6vw, 48px);
  font-weight: bold;
  color: #8b0033;
}

/* Buttons */
.buttons {
  margin-top: 30px;
}

button {
  font-size: 20px;
  padding: 12px 25px;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: 0.2s ease;
}

#yesBtn {
  background: hotpink;
  color: white;
  font-weight: bold;
}

#noBtn {
  background: gray;
  color: white;
  position: absolute;
}

/* YES result */
.result {
  display: none;
  font-size: clamp(36px, 7vw, 60px);
  font-weight: bold;
  color: #ff0066;
}

/* Graffiti hearts */
.graffiti {
  position: fixed;
  font-size: 26px;
  opacity: 0.8;
}
</style>
</head>

<body>

<div class="container">
  <h1 id="question">hlo ji, will you be my valentine?🥺☝🏻</h1>

  <div class="buttons" id="buttons">
    <button id="yesBtn">YES</button>
    <button id="noBtn">NO</button>
  </div>

  <div class="result" id="result">hm :3 (must've been the wind)</div>
</div>

<script>
// Create floating sobbing emojis
for (let i = 0; i < 35; i++) {
  let emoji = document.createElement("div");
  emoji.className = "emoji";
  emoji.innerText = "🥺";
  emoji.style.left = Math.random() * 100 + "vw";
  emoji.style.animationDuration = (6 + Math.random() * 6) + "s";
  document.body.appendChild(emoji);
}

// NO button runs away
const noBtn = document.getElementById("noBtn");
const yesBtn = document.getElementById("yesBtn");

function moveNo() {
  let x = Math.random() * (window.innerWidth - 120);
  let y = Math.random() * (window.innerHeight - 80);
  noBtn.style.left = x + "px";
  noBtn.style.top = y + "px";

  // YES grows each time NO is dodged
  let currentSize = parseFloat(window.getComputedStyle(yesBtn).fontSize);
  yesBtn.style.fontSize = currentSize + 3 + "px";
}

noBtn.addEventListener("mouseenter", moveNo);
noBtn.addEventListener("touchstart", moveNo);
noBtn.addEventListener("click", (e) => e.preventDefault());

// YES click event
yesBtn.addEventListener("click", () => {
  document.getElementById("buttons").style.display = "none";
  document.getElementById("question").style.display = "none";
  document.getElementById("result").style.display = "block";

  // Cute graffiti everywhere
  for (let i = 0; i < 50; i++) {
    let g = document.createElement("div");
    g.className = "graffiti";
    let emojis = ["🫶🏻", "😖", "❤️", "✨", "😼", "😘"];
    g.innerText = emojis[Math.floor(Math.random() * emojis.length)];
    g.style.left = Math.random() * 100 + "vw";
    g.style.top = Math.random() * 100 + "vh";
    document.body.appendChild(g);
  }
});
</script>

</body>
</html>
